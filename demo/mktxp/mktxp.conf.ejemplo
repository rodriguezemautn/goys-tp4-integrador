# Copiar como mktxp.conf (ese archivo NO se sube: esta en .gitignore)
# y reemplazar <CLAVE_MONITOREO_H3> por la clave de la entrada del mismo nombre en la base .kdbx.

[EDGE]
    hostname = 10.255.255.1

[CORE-1]
    hostname = 10.255.255.2

[CORE-2]
    hostname = 10.255.255.3

[DIST-1]
    hostname = 10.255.255.4

[DIST-2]
    hostname = 10.255.255.5

[default]
    enabled = True
    module_only = False
    hostname = localhost
    port = 8729

    username = prometheus
    password = <CLAVE_MONITOREO_H3>
    credentials_file = ""
    custom_labels = None

    use_ssl = True
    no_ssl_certificate = False
    ssl_certificate_verify = False      # certificado firmado por la CA local de cada router
    ssl_check_hostname = False
    ssl_ca_file = ""
    plaintext_login = True

    # Lo que usa el tablero. Nada mas: los CHR emulados son lentos y la
    # lectura de los 5 routers tiene que entrar en el scrape de 5 s.
    interface = True
    firewall = True
    address_list = bloqueados           # lista de la defensa (H5)
    bgp = True

    # Apagado para que el scrape no pase los 4 s (monitor consulta placa por placa)
    monitor = False
    routing_stats = False
    netwatch = False
    route = False
    neighbor = False
    health = False
    user = False

    # Lo que un CHR no tiene o el tablero no usa: apagado para ahorrar consultas
    routerboard = False
    installed_packages = False
    dhcp = False
    dhcp_lease = False
    connections = False
    connection_stats = False
    connection_stats_destinations = False
    interface_with_default_name = False
    wireguard_peers = False
    bridge_vlan = False
    pool = False
    dns = False
    ipv6_route = False
    ipv6_pool = False
    ipv6_firewall = False
    ipv6_neighbor = False
    ipv6_address_list = None
    poe = False
    public_ip = False
    wireless = False
    wireless_clients = False
    capsman = False
    capsman_clients = False
    w60g = False
    eoip = False
    gre = False
    ipip = False
    lte = False
    ipsec = False
    switch_port = False
    kid_control_assigned = False
    kid_control_dynamic = False
    queue = False
    bfd = False
    certificate = False
    container = False
    remote_dhcp_entry = None
    remote_capsman_entry = None
    interface_name_format = name
    check_for_updates = False
